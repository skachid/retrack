# Copy this to .env and fill in what you have. Retrack loads .env by itself when it starts.
# Never commit .env (it's in .gitignore), and never put real values in this file.

# Your Public Search API login, once The MLC approves your access. Needed for real checks.
MLC_USERNAME=
MLC_PASSWORD=

# Optional: only for the AI features (Smart names, AI search, --smart-import).
ANTHROPIC_API_KEY=

# Optional: the most the AI checks may cost per day, in US dollars (an estimate from token
# counts). Blank means 5. Set 0 to turn the AI checks off. Each order's cost is printed in the terminal.
RETRACK_AI_DAILY_LIMIT_USD=

# Optional: Stripe keys for paying for the fix pack. Leave blank to use "Pay (demo)".
# Use test keys (sk_test_..., pk_test_...) from the Stripe Dashboard, Developers, API keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Optional: lets Stripe confirm payments directly. Locally, `stripe listen` prints it (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Only set to 1 if you really mean to take real money with a live key (sk_live_...).
RETRACK_PAYMENTS_LIVE=
